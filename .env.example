# העתק קובץ זה ל-.env ומלא את הפרטים שלך (ראה README.md להוראות מלאות)

# כתובת המייל של חשבון השירות (Service Account) שיצרת בגוגל קלאוד
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# המפתח הפרטי מתוך קובץ ה-JSON שהורדת (השדה private_key), כולל שורות ה-BEGIN/END
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# המזהה של גיליון האקסל בגוגל שיטס (החלק שבין /d/ ל-/edit בכתובת האתר של הגיליון)
GOOGLE_SHEET_ID=your-google-sheet-id
